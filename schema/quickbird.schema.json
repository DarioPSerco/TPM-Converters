{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eopf-eos.esa.int/schema/quickbird.schema.json",
  "title": "EOPF-EOS-style QuickBird-2 product metadata manifest",
  "description": "GeoJSON Feature manifest for a QuickBird-2 (BGI_*) product. STRUCTURE mirrors schema/worldview.schema.json (the structural template); VALUES are QuickBird-2's own (from this mission's extraction + ingest_quickbird.cfg). There is NO dedicated EOPF-EOS spec for QuickBird-2. No WorldView values appear here. WorldView-only slots (wavelengths) are dropped; 'required' lists only fields the quickbird_json converter reliably produces. See quickbird_fields.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "id", "geometry", "properties"],
  "properties": {
    "type": { "const": "Feature" },
    "id": { "type": "string", "minLength": 1 },
    "geometry": {
      "description": "GeoJSON Polygon for non-MP types; null for MP types (BGI_PAN_MP, BGI_4B__MP).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      ]
    },
    "bbox": {
      "type": "array",
      "description": "[west, south, east, north]. Present for MP types only (BGI_PAN_MP, BGI_4B__MP).",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "created", "status", "acquisitionInformation", "productInformation", "links"],
      "properties": {
        "title": { "type": "string" },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "created": {
          "type": "string",
          "description": "Native generationTime (METADATA_DATASET_PRODUCTION_DATE). $comment: same caveat as worldview_json - native generation time, not package creation time.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "status": {
          "type": "string",
          "description": "From cfg METADATA_STATUS (QuickBird-2's own value, e.g. 'ARCHIVED'). NOT the WorldView fixed 'NOMINAL'."
        },
        "acquisitionInformation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "instrument", "acquisitionParameters"],
          "properties": {
            "platform": {
              "type": "object",
              "additionalProperties": false,
              "required": ["platformShortName"],
              "properties": {
                "platformShortName": {
                  "type": "string",
                  "enum": ["QuickBird-2"],
                  "description": "From cfg/satId (satId fixed QB02)."
                },
                "orbitType": {
                  "type": "string",
                  "description": "$comment: WorldView-schema slot with no QuickBird-2 extraction source -> GAP, omitted by the emitter."
                },
                "platformSerialIdentifier": {
                  "type": "integer",
                  "description": "cfg METADATA_PLATFORM_ID=2."
                }
              }
            },
            "instrument": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sensorType", "instrumentShortName"],
              "properties": {
                "sensorType": { "type": "string", "description": "cfg METADATA_SENSOR_TYPE (OPTICAL)." },
                "instrumentShortName": {
                  "type": "string",
                  "enum": ["BGI"],
                  "description": "cfg METADATA_INSTRUMENT=BGI (Ball Global Imaging system)."
                }
              }
            },
            "acquisitionParameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["acquisitionType", "beginningDateTime", "endingDateTime", "operationalMode", "resolution", "acquisitionAngles"],
              "properties": {
                "acquisitionType": { "type": "string", "description": "cfg METADATA_ACQUISITION_TYPE (NOMINAL)." },
                "beginningDateTime": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
                },
                "endingDateTime": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
                },
                "operationalMode": {
                  "type": "string",
                  "enum": ["PAN", "PM"],
                  "description": "QuickBird-2's own METADATA_SENSOR_OPERATIONAL_MODE (buildTypeCode): PAN or PM. NOT the WorldView MS4B/MS8B/PANCHROMATIC/STEREO vocabulary."
                },
                "resolution": { "type": "number" },
                "wrsLongitudeGrid": { "type": "string", "pattern": "^[EW][0-9]{3}$" },
                "wrsLatitudeGrid": { "type": "string", "pattern": "^[NS][0-9]{2}$" },
                "acquisitionAngles": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["illuminationAzimuthAngle", "illuminationElevationAngle"],
                  "properties": {
                    "illuminationAzimuthAngle": { "type": "number" },
                    "illuminationElevationAngle": { "type": "number" }
                  }
                }
              }
            }
          }
        },
        "productInformation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["productType", "size", "resourceLineage"],
          "properties": {
            "productType": {
              "type": "string",
              "enum": ["BGI_PAN_2A", "BGI_PAN_MP", "BGI_PAN__OR", "BGI_4B__2A", "BGI_4B__MP", "BGI_4B__OR"],
              "description": "QuickBird-2 type code (product_quickbird.REF_TYPECODES). 'BGI_PAN__OR' double underscore is as in the source list."
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "description": "Summed native-content bytes (product.tmpSize); no .SIP.ZIP is produced."
            },
            "referenceSystemIdentifier": {
              "type": "string",
              "description": "cfg METADATA_REFERENCE_SYSTEM_IDENTIFIER=EPSG:4326; emitted for MP types."
            },
            "processingLevel": {
              "type": "string",
              "description": "QuickBird-2's own typecode level token (2A / OR / MP). No WorldView 1B/2A/3 mapping applied."
            },
            "cloudCover": { "type": "number", "description": "Cloud cover %; omitted if native value absent (sentinel -999)." },
            "resourceLineage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["processStep"],
              "properties": {
                "processStep": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["description", "stepDateTime", "processor", "reference", "source", "processingInformation"],
                  "properties": {
                    "description": { "type": "string" },
                    "stepDateTime": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["created"],
                      "properties": { "created": { "type": "string" } }
                    },
                    "processor": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["role"],
                      "properties": {
                        "role": { "type": "string" },
                        "party": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "name": { "type": "string" },
                            "type": { "type": "string" }
                          }
                        }
                      }
                    },
                    "reference": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["title", "edition"],
                      "properties": {
                        "title": { "type": "string" },
                        "edition": { "type": "string" }
                      }
                    },
                    "source": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["sourceCitation", "processedLevel"],
                      "properties": {
                        "sourceCitation": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["title"],
                          "properties": { "title": { "type": "string" } }
                        },
                        "processedLevel": {
                          "type": "string",
                          "enum": ["LV1B", "LV2A", "LV3A", "LV3D", "LV3E", "LV3F", "LV3G", "LV3X", "LV4", "Stereo1B", "Stereo2A", "StereoOR2A"],
                          "description": "Native processed level (product_quickbird.REF_PROCESSING_LEVEL - QuickBird-2's own enum)."
                        }
                      }
                    },
                    "processingInformation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["softwareReference"],
                      "properties": {
                        "softwareReference": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["title", "edition"],
                          "properties": {
                            "title": { "type": "string" },
                            "edition": { "type": "string" }
                          }
                        }
                      }
                    },
                    "output": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "sourceCitation": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": { "title": { "type": "string" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measurements", "preview"],
          "properties": {
            "measurements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/link" } },
            "preview": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/link" } }
          }
        }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "type", "title", "category"],
      "properties": {
        "href": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" }
      }
    }
  }
}
