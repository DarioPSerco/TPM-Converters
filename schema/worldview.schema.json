{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eopf-eos.esa.int/schema/worldview.schema.json",
  "title": "EOPF-EOS WorldView product metadata manifest",
  "description": "GeoJSON Feature manifest for a WorldView 1-4 / Legion product, derived from 'EOPF-EOS Specialization for WorldView Products - v1.0D' (marker_out/) and the EO-SIP Spec Analysis JSONPath crosswalk. 'required' lists only fields this converter (worldview_json) reliably produces from the native product; spec-mandatory fields that are not derivable here are OPTIONAL and carry a $comment flag. See worldview_fields.md for the per-field reconciliation and all flagged conflicts / OCR-suspect values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "id", "geometry", "properties"],
  "properties": {
    "type": { "const": "Feature" },
    "id": {
      "type": "string",
      "description": "EOPF-EOS package filename without extension (spec Table 3).",
      "minLength": 1
    },
    "geometry": {
      "description": "GeoJSON Polygon for non-MP product types; null for Map-Scale Ortho (MP) types (spec Table 4).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      ]
    },
    "bbox": {
      "type": "array",
      "description": "[west, south, east, north]. Spec mandates bbox for MP types only (WV6_PAN_MP, WV1_PAN_MP, WV1_4B__MP, WV1_8B__MP, WV1_S8B_MP); absent otherwise.",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "created", "status", "acquisitionInformation", "productInformation", "links"],
      "properties": {
        "title": { "type": "string", "description": "Equals $.id (spec Table 6)." },
        "date": {
          "type": "string",
          "description": "RFC 3339 range '<begin>/<end>' (spec Table 6).",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "created": {
          "type": "string",
          "description": "Package creation date, RFC 3339 (spec Table 6). $comment: converter emits native generationTime here; spec wants actual EOPF-EOS package creation time - FLAGGED in worldview_fields.md.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "status": { "const": "NOMINAL", "description": "Spec Table 5 fixed value." },
        "acquisitionInformation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "instrument", "acquisitionParameters"],
          "properties": {
            "platform": {
              "type": "object",
              "additionalProperties": false,
              "required": ["platformShortName", "orbitType"],
              "properties": {
                "platformShortName": {
                  "type": "string",
                  "enum": ["WorldView-1", "WorldView-2", "WorldView-3", "WorldView-4", "WorldView Legion"],
                  "description": "Spec Table 8."
                },
                "orbitType": { "const": "LEO", "description": "Spec Table 8 fixed value." },
                "platformSerialIdentifier": {
                  "type": "integer",
                  "description": "$comment: present in spec example §6.1 only, not in Table 8 - FLAGGED. Emitted from platform id for WV1-4."
                }
              }
            },
            "instrument": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sensorType", "instrumentShortName"],
              "properties": {
                "sensorType": { "const": "OPTICAL", "description": "Spec Table 9 fixed value." },
                "instrumentShortName": {
                  "type": "string",
                  "enum": ["WorldView-60 Camera", "WorldView-110 Camera", "SpaceView-110 Camera", "WorldView Legion Camera"],
                  "description": "Spec Table 9, per platform."
                }
              }
            },
            "acquisitionParameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["acquisitionType", "beginningDateTime", "endingDateTime", "operationalMode", "resolution", "acquisitionAngles"],
              "properties": {
                "acquisitionType": { "const": "NOMINAL", "description": "Spec Table 10 fixed value." },
                "beginningDateTime": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "description": "Sensing start, RFC 3339 (spec Table 11)."
                },
                "endingDateTime": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "description": "Sensing end, RFC 3339 (spec Table 11); = beginningDateTime if unavailable."
                },
                "operationalMode": {
                  "type": "string",
                  "enum": ["MS4B", "MS8B", "PANCHROMATIC", "STEREO"],
                  "description": "Spec Table 10. $comment: native->spec-mode mapping is INFERRED from band count / native processed level; spec Table 2 association is OCR-garbled - FLAGGED."
                },
                "resolution": {
                  "type": "number",
                  "description": "Spatial resolution / GSD in metres (spec Table 10)."
                },
                "wrsLongitudeGrid": {
                  "type": "string",
                  "pattern": "^[EW][0-9]{3}$",
                  "description": "Scene-centre longitude grid, e.g. 'W100' (spec Table 10). $comment: spec reviewers (AS25/AD26) propose REMOVAL - no WRS for WorldView - FLAGGED."
                },
                "wrsLatitudeGrid": {
                  "type": "string",
                  "pattern": "^[NS][0-9]{2}$",
                  "description": "Scene-centre latitude grid, e.g. 'S19' (spec Table 10). $comment: same removal note as wrsLongitudeGrid - FLAGGED."
                },
                "acquisitionAngles": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["illuminationAzimuthAngle", "illuminationElevationAngle"],
                  "properties": {
                    "illuminationAzimuthAngle": { "type": "number", "description": "Sun azimuth (spec Table 12)." },
                    "illuminationElevationAngle": { "type": "number", "description": "Sun elevation (spec Table 12)." }
                  }
                },
                "wavelengths": {
                  "type": "array",
                  "description": "$comment: spec Table 13 (Mandatory per spec) - NOT derivable from native IMD/XML by this converter and not in legacy; OMITTED - FLAGGED as coverage gap. Field name spelling is OCR-inconsistent (wavelenght/wavelenghts/wavelengths).",
                  "items": {
                    "type": "object",
                    "properties": {
                      "startWavelength": { "type": "number" },
                      "endWavelength": { "type": "number" },
                      "spectralRange": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "productInformation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["productType", "size", "resourceLineage"],
          "properties": {
            "productType": {
              "type": "string",
              "enum": [
                "WV6_PAN_2A", "WV6_PAN_OR", "WV6_PAN_MP",
                "WV1_4B__2A", "WV1_4B__OR", "WV1_4B__MP",
                "WV1_8B__2A", "WV1_8B__OR", "WV1_8B__MP",
                "WV1_PAN_2A", "WV1_PAN_OR", "WV1_PAN_MP",
                "WV1_S8B_2A", "WV1_S8B_MP"
              ],
              "description": "Spec §1.1 / Table 14 product type code (with '__' padding per spec §1.1 scope list; the Table-1/Table-2 single-underscore forms are OCR-collapsed)."
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "description": "Product size in bytes (spec Table 14). $comment: converter emits summed native-content size (no .SIP.ZIP is produced); spec means package size - FLAGGED."
            },
            "referenceSystemIdentifier": {
              "type": "string",
              "description": "CRS URI (spec Table 14). $comment: spec mandates ONLY for MP types; sourced from config METADATA_REFERENCE_SYSTEM_IDENTIFIER (EPSG:4326). Legacy backfill: native utmZone (not wired). FLAGGED."
            },
            "processingLevel": {
              "type": "string",
              "description": "Spec Table 15. $comment: spec enum (1B/2A/3) is OCR-SUSPECT and reviewer-disputed; converter mapping from native level token is inferred (2A->2A, MP->3) and OMITTED for ambiguous tokens - FLAGGED, verify against PDF/[AD02]."
            },
            "cloudCover": {
              "type": "number",
              "description": "Cloud cover percentage (spec Table 17); omitted if native value absent (converter sentinel -999)."
            },
            "resourceLineage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["processStep"],
              "properties": {
                "processStep": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["description", "stepDateTime", "processor", "reference", "source", "processingInformation"],
                  "properties": {
                    "description": { "const": "EOPF-EOS Converter for WorldView" },
                    "stepDateTime": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["created"],
                      "properties": { "created": { "type": "string" } }
                    },
                    "processor": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["role"],
                      "properties": {
                        "role": { "const": "processor" },
                        "party": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "name": { "type": "string" },
                            "type": { "type": "string" }
                          },
                          "description": "$comment: spec comment AD44 proposes removing processor.party - FLAGGED."
                        }
                      }
                    },
                    "reference": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["title", "edition"],
                      "properties": {
                        "title": { "type": "string" },
                        "edition": { "type": "string" }
                      }
                    },
                    "source": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["sourceCitation", "processedLevel"],
                      "properties": {
                        "sourceCitation": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["title"],
                          "properties": { "title": { "type": "string" } }
                        },
                        "processedLevel": {
                          "type": "string",
                          "enum": ["LV1B", "LV2A", "LV3A", "LV3D", "LV3E", "LV3F", "LV3G", "LV3X", "LV4", "Stereo1B", "Stereo2A", "StereoOR2A"],
                          "description": "Native processing level (spec Table 16)."
                        }
                      }
                    },
                    "processingInformation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["softwareReference"],
                      "properties": {
                        "softwareReference": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["title", "edition"],
                          "properties": {
                            "title": { "type": "string" },
                            "edition": { "type": "string" }
                          }
                        }
                      }
                    },
                    "output": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "sourceCitation": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": { "title": { "type": "string" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measurements", "preview"],
          "properties": {
            "measurements": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/link" }
            },
            "preview": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/link" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "type", "title", "category"],
      "properties": {
        "href": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" }
      }
    }
  }
}
