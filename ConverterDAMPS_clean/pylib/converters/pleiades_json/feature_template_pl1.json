{
  "type": "Feature",
  "id": "<product id>",
  "geometry": {
    "type": "Polygon",
    "coordinates": "<footprint closed ring [[lon,lat],...]>"
  },
  "properties": {
    "status": "ACQUIRED",
    "title": "<product id>",
    "date": "<beginningDateTime>/<endingDateTime>",
    "created": "<package creation datetime>",
    "acquisitionInformation": [{
      "platform": {
        "platformShortName": "<platformShortName>",
        "orbitType": "<orbitType>"
      },
      "instrument": {
        "instrumentShortName": "<instrumentShortName>",
        "sensorType": "<sensorType>"
      },
      "acquisitionParameters": "<acquisition parameters array, one entry per component (spec Tables 10-16)>"
    }],
    "productInformation": {
      "size": "<native product size bytes (number)>",
      "productType": "<typecode>",
      "processingLevel": "<processingLevel>",
      "processingDate": "<processing datetime>",
      "resourceLineage": [{
        "processStep": [{
          "description": "<mission converter description>",
          "stepDateTime": {
            "created": "<package creation datetime>"
          },
          "processor": [{
            "role": "processor",
            "party": [{
              "name": "EOF-EOS External Data Handling",
              "type": "CI_Organisation"
            }]
          }],
          "reference": [{
            "title": "<mission spec reference title>",
            "edition": "<mission spec edition>"
          }],
          "source": [{
            "sourceCitation": {
              "title": "<native product name>"
            },
            "processedLevel": {
              "code": "<processed level code>"
            }
          }],
          "processingInformation": {
            "softwareReference": {
              "title": "<converter software name>",
              "edition": "<converter software version>"
            }
          },
          "output": [{
            "sourceCitation": {
              "title": "<product id>.ZIP"
            }
          }]
        }]
      }]
    },
    "links": {
      "measurements": "<measurements links array (spec Table 21)>",
      "previews": "<previews links array (spec Table 22)>"
    }
  }
}
